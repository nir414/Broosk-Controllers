'Created: 2026/03/06
'Purpose: Flash 수명을 고려한 안전한 파일 저장 관리자
'Notes:
' - LEGACY ModuleName(Storage_File_Manager) 대체 구현
' - 신규/개선 코드는 PST 모듈명을 사용
Module PST ' Persistence_FileStore VER 1.0.15

	' 저장 결과 상수
	Public Const SAVE_SUCCESS As Integer = 1
	Public Const SAVE_ERROR_PATH_INVALID As Integer = -1
	Public Const SAVE_ERROR_WRITE_FAILED As Integer = -2
	Public Const SAVE_ERROR_BACKUP_FAILED As Integer = -3
	Public Const SAVE_ERROR_TEMP_FAILED As Integer = -4
	Public Const SAVE_ERROR_MOVE_FAILED As Integer = -5

	' 파일 시스템 경로 상수
	Public Const FLASH_PREFIX As String = "/flash/"
	Public Const TEMP_PREFIX As String = FND.ROMDISK_TMP_PREFIX  ' 공통 ROMDISK/tmp 경로

	' 임시 파일 경로 생성용 내부 카운터 (타임스탬프 충돌 방지)
	Private Dim tempSeq As Integer
	Private Dim tempSeqLock As New SpinLock

	'=========================
	' Public API
	'=========================
	Public Function SafeSaveFile(path As String, content As String, useBackup As Integer) As Integer
		If path Is Nothing Then
			LOG.cehLog("ERR: Invalid path (Nothing)", "PST.SafeSaveFile")
			SafeSaveFile = SAVE_ERROR_PATH_INVALID
			Exit Function
		End If
		If path = "" Then
			LOG.cehLog("ERR: Invalid path (empty string)", "PST.SafeSaveFile")
			SafeSaveFile = SAVE_ERROR_PATH_INVALID
			Exit Function
		End If
		If content Is Nothing Then
			content = ""
		End If

		If FileExists(path) Then
			If IsContentIdentical(path, content) Then
				SafeSaveFile = SAVE_SUCCESS
				Exit Function
			End If
		End If

		If Not EnsureDirectory(path) Then
			SafeSaveFile = SAVE_ERROR_PATH_INVALID
			Exit Function
		End If

		If IsFlashPath(path) Then
			SafeSaveFile = SafeSaveToFlash(path, content, useBackup)
		Else
			SafeSaveFile = DirectSaveFile(path, content)
		End If
	End Function

	Public Function SafeSaveFile(path As String, content As String) As Integer
		SafeSaveFile = SafeSaveFile(path, content, 1)
	End Function

	Public Function FileExists(path As String) As Integer
		Dim ex As New Exception
		Try
			If path Is Nothing Then
				FileExists = 0
				Exit Function
			End If
			If path = "" Then
				FileExists = 0
				Exit Function
			End If

			Dim pos As Integer
			Dim dirPath As String
			Dim fileName As String
			pos = FindLastSlashPos(path)
			If pos > 0 Then
				dirPath = Mid(path, 1, pos - 1)
				fileName = Mid(path, pos + 1)
			Else
				dirPath = "."
				fileName = path
			End If
			If Mid(dirPath, Len(dirPath), 1) <> "/" Then
				dirPath = dirPath & "/"
			End If

			Dim files() As String
			Dim i As Integer
			files = File.GetFiles(dirPath)
			For i = 0 To files.Length - 1
				If files(i) = fileName Or files(i) = path Then
					FileExists = 1
					Exit Function
				End If
			Next
			FileExists = 0
		Catch ex
			FileExists = 0
		End Try
	End Function

	Public Function ReadFileContent(path As String) As String
		Dim ex As New Exception
		Try
			If Not FileExists(path) Then
				ReadFileContent = ""
				Exit Function
			End If

			Dim reader As StreamReader
			Dim n As Integer
			Dim text As String
			reader = New StreamReader(path)
			text = ""
			n = reader.Read()
			While n >= 0
				text = text & Chr(n)
				n = reader.Read()
			End While
			reader.Close()
			ReadFileContent = text
		Catch ex
			LOG.cehLogEx(ex, "PST.ReadFileContent | Path: " & path)
			ReadFileContent = ""
		End Try
	End Function

	Public Function RestoreFromBackup(path As String) As Integer
		Dim ex As New Exception
		Try
			Dim backupPath As String
			backupPath = path & ".bak"
			If Not FileExists(backupPath) Then
				LOG.cehLog("WARN: No backup found | Path: " & backupPath, "PST.RestoreFromBackup")
				RestoreFromBackup = 0
				Exit Function
			End If
			File.Copy(backupPath, path)
			LOG.cehLog("Restored from backup | Path: " & path, "PST.RestoreFromBackup")
			RestoreFromBackup = 1
		Catch ex
			LOG.cehLogEx(ex, "PST.RestoreFromBackup | Path: " & path)
			RestoreFromBackup = 0
		End Try
	End Function

	Public Function DeleteFileWithBackup(path As String) As Integer
		Dim ex As New Exception
		Try
			If Not FileExists(path) Then
				DeleteFileWithBackup = 1
				Exit Function
			End If
			Dim backupPath As String
			backupPath = path & ".deleted"
			File.Copy(path, backupPath)
			File.DeleteFile(path)
			LOG.cehLog("File deleted with backup | Path: " & path, "PST.DeleteFileWithBackup")
			DeleteFileWithBackup = 1
		Catch ex
			LOG.cehLogEx(ex, "PST.DeleteFileWithBackup | Path: " & path)
			DeleteFileWithBackup = 0
		End Try
	End Function

	Public Sub CleanupTempFiles()
		Dim ex As New Exception
		Try
			Dim files() As String
			Dim i As Integer
			files = File.GetFiles(TEMP_PREFIX)
			For i = 0 To files.Length - 1
				If Len(files(i)) >= 4 Then
					If Mid(files(i), Len(files(i)) - 3) = ".tmp" Then
						File.DeleteFile(TEMP_PREFIX & files(i))
						LOG.cehLog("Cleaned temp file | File: " & files(i), "PST.CleanupTempFiles")
					End If
				End If
			Next
		Catch ex
			If ex.ErrorCode = -508 Then
				' tmp 디렉터리가 아직 없는 경우(클린 부팅): 정리할 파일 없음 → 정상 처리
			Else
				LOG.cehLogEx(ex, "PST.CleanupTempFiles")
			End If
		End Try
	End Sub

	Public Function IsFlashPath(path As String) As Integer
		If Mid(path, 1, Len(FLASH_PREFIX)) = FLASH_PREFIX Then
			IsFlashPath = 1
		Else
			IsFlashPath = 0
		End If
	End Function

	'=========================
	' Internal implementation
	'=========================
	Private Function SafeSaveToFlash(path As String, content As String, useBackup As Integer) As Integer
		Dim tempPath As String
		Dim backupPath As String
		tempPath = GenerateTempPath(path)

		If DirectSaveFile(tempPath, content) <> SAVE_SUCCESS Then
			LOG.cehLog("ERR: Failed to write temp file | Path: " & tempPath, "PST.SafeSaveToFlash")
			SafeSaveToFlash = SAVE_ERROR_TEMP_FAILED
			Exit Function
		End If

		If useBackup = 1 And FileExists(path) Then
			backupPath = path & ".bak"
			If Not CreateBackup(path, backupPath) Then
				LOG.cehLog("WARN: Backup creation failed | Path: " & backupPath, "PST.SafeSaveToFlash")
			End If
		End If

		If Not AtomicMove(tempPath, path) Then
			LOG.cehLog("ERR: Failed to move temp to final | Temp: " & tempPath & " -> Final: " & path, "PST.SafeSaveToFlash")
			DeleteTempFileNoThrow(tempPath)
			SafeSaveToFlash = SAVE_ERROR_MOVE_FAILED
			Exit Function
		End If

		LOG.cehLog("Safe save completed | Path: " & path, "PST.SafeSaveToFlash")
		SafeSaveToFlash = SAVE_SUCCESS
	End Function

	Private Function DirectSaveFile(path As String, content As String) As Integer
		Dim ex As New Exception
		Try
			Dim writer As StreamWriter
			writer = New StreamWriter(path)
			writer.Write(content)
			writer.Flush()
			writer.Close()
			DirectSaveFile = SAVE_SUCCESS
		Catch ex
			LOG.cehLogEx(ex, "PST.DirectSaveFile | Path: " & path)
			DirectSaveFile = SAVE_ERROR_WRITE_FAILED
		End Try
	End Function

	Private Function IsContentIdentical(path As String, newContent As String) As Integer
		Dim ex As New Exception
		Try
			Dim fileSize As Integer
			fileSize = File.Length(path)
			If fileSize <> Len(newContent) Then
				IsContentIdentical = 0
				Exit Function
			End If
			Dim existingContent As String
			existingContent = ReadFileContent(path)
			If existingContent = newContent Then
				IsContentIdentical = 1
			Else
				IsContentIdentical = 0
			End If
		Catch ex
			IsContentIdentical = 0
		End Try
	End Function

	Private Function CreateBackup(originalPath As String, backupPath As String) As Integer
		Dim ex As New Exception
		Try
			File.Copy(originalPath, backupPath)
			CreateBackup = 1
		Catch ex
			CreateBackup = 0
		End Try
	End Function

	Private Function AtomicMove(sourcePath As String, destPath As String) As Integer
		Dim ex As New Exception
		Try
			File.Copy(sourcePath, destPath)
			File.DeleteFile(sourcePath)
			AtomicMove = 1
		Catch ex
			AtomicMove = 0
		End Try
	End Function

	Private Sub DeleteTempFileNoThrow(path As String)
		Dim ex As Exception
		If path Is Nothing Then Exit Sub
		If path = "" Then Exit Sub
		Try
			File.DeleteFile(path)
		Catch ex
			' best-effort cleanup
		End Try
	End Sub

	' パス文字列中の最後の "/" 位置を返す (0-based index)。見つからなければ -1。
	Private Function FindLastSlashPos(ByVal path As String) As Integer
		Dim i As Integer
		FindLastSlashPos = -1
		For i = Len(path) To 1 Step -1
			If Mid(path, i, 1) = "/" Then
				FindLastSlashPos = i
				Exit Function
			End If
		Next
	End Function

	Private Function GenerateTempPath(originalPath As String) As String
		Dim fileName As String
		Dim safeFileName As String
		Dim safeTime As String
		Dim pos As Integer
		Dim seq As Integer
		pos = FindLastSlashPos(originalPath)
		If pos > 0 Then
			fileName = Mid(originalPath, pos + 1)
		Else
			fileName = originalPath
		End If
		' 순번 카운터: 같은 초 안에 여러 저장이 겹쳐도 tmp 파일명이 충돌하지 않도록 보장
		tempSeqLock.Acquire()
		tempSeq = tempSeq + 1
		seq = tempSeq
		tempSeqLock.Release()
		safeFileName = SanitizeTempNamePart(fileName)
		safeTime = SanitizeTempNamePart(FND.timeString())
		If safeFileName = "" Then safeFileName = "save"
		If safeTime = "" Then safeTime = "time"
		GenerateTempPath = TEMP_PREFIX & safeFileName & "_" & safeTime & "_" & CStr(seq) & ".tmp"
	End Function

	Private Function SanitizeTempNamePart(value As String) As String
		Dim i As Integer
		Dim ch As String
		Dim result As String
		If value Is Nothing Then
			SanitizeTempNamePart = ""
			Exit Function
		End If
		result = ""
		For i = 1 To Len(value)
			ch = Mid(value, i, 1)
			If (ch >= "0" And ch <= "9") Or (ch >= "A" And ch <= "Z") Or (ch >= "a" And ch <= "z") Or ch = "." Or ch = "_" Or ch = "-" Then
				result = result & ch
			Else
				result = result & "_"
			End If
		Next
		SanitizeTempNamePart = result
	End Function


	Private Function EnsureDirectory(filePath As String) As Integer
		Dim ex As New Exception
		Try
			Dim dirPath As String
			Dim pos As Integer
			pos = FindLastSlashPos(filePath)
			If pos > 0 Then
				dirPath = Mid(filePath, 1, pos - 1)
				If Not DirectoryExists(dirPath) Then
					File.CreateDirectory(dirPath)
				End If
			End If
			EnsureDirectory = 1
		Catch ex
			If ex.ErrorCode = -510 Then
				' 디렉터리가 이미 존재하는 경우: 의도된 idempotent 성공 처리
				EnsureDirectory = 1
			Else
				Console.WriteLine(FND.timeString() & " [" & Thread.CurrentThread.Name & "] ERR(" & CStr(ex.ErrorCode) & "): PST.EnsureDirectory - " & ex.Message() & " | Path: " & filePath)
				EnsureDirectory = 0
			End If
		End Try
	End Function

	Private Function DirectoryExists(dirPath As String) As Integer
		Dim ex As New Exception
		Try
			If dirPath Is Nothing Then
				DirectoryExists = 0
				Exit Function
			End If
			If dirPath = "" Then
				DirectoryExists = 0
				Exit Function
			End If
			If Mid(dirPath, Len(dirPath), 1) <> "/" Then
				dirPath = dirPath & "/"
			End If

			Dim files() As String
			files = File.GetFiles(dirPath)
			DirectoryExists = 1
		Catch ex
			DirectoryExists = 0
		End Try
	End Function

End Module


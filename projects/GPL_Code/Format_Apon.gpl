'Created: 2026/03/26
'Updated: 2026/04/20 (APON spec full coverage: inline comments, quoted/escaped strings,
'                    multi-line arrays, text blocks, type annotations, compact+non-compact
'                    root, root-level arrays, auto-quoting writer, boolean accessors)
'Purpose: APON(Aspectran Parameters Object Notation) 계층적 설정 파일 파서/기록기/저장소
'Reference (official APON docs):
' - KO: https://aspectran.com/ko/docs/guides/introduce-apon/
'Format (spec-conformant subset):
'   # comment (line-end)
'   key: value                     # inline comment
'   key: "quoted \"value\""
'   key(int): 30
'   key: [item1, item2, item3]
'   key: [
'       item1
'       item2, item3
'   ]
'   key: {
'       nestedKey: value
'   }
'   description(text): (
'     |line 1
'     |line 2
'   )
'
'Requires:
' - Foundation_Utils (FND: CRLF, timeString)
' - Observability_ErrorHandler (OBS: cehLog, cehLogEx, cehThrow)
' - Pipeline_AsyncSave (PIP: Enqueue/SaveSync/ReadFile/FileExists/RestoreFromBackup) [AponStore only]
Module APN ' Format_Apon VER 1.2.0
	
	Public Const APON_VALUE As Integer = 0
	Public Const APON_BLOCK As Integer = 1
	Public Const APON_ARRAY As Integer = 2
	Public Const APON_TEXT  As Integer = 3
	
	' Render styles (AponFile.BuildStringStyled)
	Public Const APON_STYLE_PRETTY      As Integer = 0
	Public Const APON_STYLE_SINGLE_LINE As Integer = 1
	Public Const APON_STYLE_COMPACT     As Integer = 2
	
	
	''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
	'''''''''''''''''''''''''''' AponNode '''''''''''''''''''''''''''
	''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
	
	Public Class AponNode
		
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		'''''''''''''''''''''''' PRIVATE ''''''''''''''''''''''''''''
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		
		Private Dim m_key As String
		Private Dim m_value As String
		Private Dim m_nodeType As Integer
		Private Dim m_typeHint As String    ' APON 타입 어노테이션("string","int","long","float","double","boolean","text","parameters","variable","object") — 비어 있으면 생략
		Private Dim m_children() As AponNode
		Private Dim m_childCount As Integer
		Private Dim m_arrayValues() As String
		Private Dim m_arrayCount As Integer
		
		
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		'''''''''''''''''''''' CONSTRUCTORS '''''''''''''''''''''''''
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		
		' Root or Block node (empty)
		Public Sub New()
			m_key = ""
			m_value = ""
			m_typeHint = ""
			m_nodeType = APON_BLOCK
			m_childCount = 0
			m_arrayCount = 0
			ReDim m_children(16)
			ReDim m_arrayValues(0)
		End Sub
		
		' Named block node
		Public Sub New(key As String)
			m_key = key
			m_value = ""
			m_typeHint = ""
			m_nodeType = APON_BLOCK
			m_childCount = 0
			m_arrayCount = 0
			ReDim m_children(16)
			ReDim m_arrayValues(0)
		End Sub
		
		
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		'''''''''''''''''''''' PROPERTIES '''''''''''''''''''''''''''
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		
		Public Property key As String
			Get
				Return m_key
			End Get
			Set (value As String)
				m_key = value
			End Set
		End Property
		
		Public ReadOnly Property nodeType As Integer
			Get
				Return m_nodeType
			End Get
		End Property
		
		Public ReadOnly Property childCount As Integer
			Get
				Return m_childCount
			End Get
		End Property
		
		Public ReadOnly Property value As String
			Get
				Return m_value
			End Get
		End Property
		
		Public ReadOnly Property arrayCount As Integer
			Get
				Return m_arrayCount
			End Get
		End Property
		
		' APON 타입 어노테이션 (없으면 빈 문자열)
		Public Property typeHint As String
			Get
				Return m_typeHint
			End Get
			Set (value As String)
				m_typeHint = value
			End Set
		End Property
		
		
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		'''''''''''''''''''' CHILD ACCESS '''''''''''''''''''''''''''
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		
		' Find child node by key (returns Nothing if not found)
		Public Function GetChild(childKey As String) As AponNode
			Dim i As Integer
			For i = 0 To m_childCount - 1
				If m_children(i).key = childKey Then
					Return m_children(i)
				End If
			Next
			Return Nothing
		End Function
		
		' Get child node by index
		Public Function GetChildByIndex(index As Integer) As AponNode
			If index >= 0 And index < m_childCount Then
				Return m_children(index)
			End If
			Return Nothing
		End Function
		
		' Check if child exists
		Public Function HasChild(childKey As String) As Boolean
			Dim i As Integer
			For i = 0 To m_childCount - 1
				If m_children(i).key = childKey Then
					Return True
				End If
			Next
			Return False
		End Function
		
		
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		'''''''''''''''''''' VALUE GETTERS ''''''''''''''''''''''''''
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		
		' Get string value of child by key
		Public Function GetString(childKey As String, defaultValue As String) As String
			Dim child As AponNode
			child = GetChild(childKey)
			If child Is Nothing Then
				Return defaultValue
			End If
			Return child.value
		End Function
		
		' Get integer value of child by key
		Public Function GetInt(childKey As String, defaultValue As Integer) As Integer
			Dim child As AponNode
			child = GetChild(childKey)
			If child Is Nothing Then
				Return defaultValue
			End If
			If child.value.Length = 0 Then
				Return defaultValue
			End If
			Return CInt(child.value)
		End Function
		
		' Get double value of child by key
		Public Function GetDbl(childKey As String, defaultValue As Double) As Double
			Dim child As AponNode
			child = GetChild(childKey)
			If child Is Nothing Then
				Return defaultValue
			End If
			If child.value.Length = 0 Then
				Return defaultValue
			End If
			Return CDbl(child.value)
		End Function
		
		' Get boolean value of child by key (accepts: true/false/yes/no/1/0, case-insensitive)
		Public Function GetBool(childKey As String, defaultValue As Boolean) As Boolean
			Dim child As AponNode
			Dim v As String
			child = GetChild(childKey)
			If child Is Nothing Then
				Return defaultValue
			End If
			v = child.value
			If v.Length = 0 Then
				Return defaultValue
			End If
			v = v.ToLower().Trim()
			If v = "true" Or v = "yes" Or v = "1" Or v = "on" Then
				Return True
			End If
			If v = "false" Or v = "no" Or v = "0" Or v = "off" Then
				Return False
			End If
			Return defaultValue
		End Function
		
		' NOTE: GPL은 Function에서 배열 반환을 지원하지 않음
		' 배열 접근은 GetArrayCount(key) + GetChild(key).GetArrayValue(i) 조합 사용
		
		' Get array element count of child by key
		Public Function GetArrayCount(childKey As String) As Integer
			Dim child As AponNode
			child = GetChild(childKey)
			If child Is Nothing Then
				Return 0
			End If
			Return child.arrayCount
		End Function
		
		' Get single array element by index (on this node)
		Public Function GetArrayValue(index As Integer) As String
			If index >= 0 And index < m_arrayCount Then
				Return m_arrayValues(index)
			End If
			Return ""
		End Function
		
		
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		'''''''''''''''''''' VALUE SETTERS ''''''''''''''''''''''''''
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		
		' Set string value (creates child if not exist)
		Public Sub SetString(childKey As String, newValue As String)
			Dim child As AponNode
			child = GetChild(childKey)
			If child Is Nothing Then
				child = New AponNode()
				child.key = childKey
				AddChildNode(child)
			End If
			child.SetValueData(newValue)
		End Sub
		
		' Set integer value
		Public Sub SetInt(childKey As String, newValue As Integer)
			SetString(childKey, CStr(newValue))
		End Sub
		
		' Set boolean value (stored as "true"/"false")
		Public Sub SetBool(childKey As String, newValue As Boolean)
			If newValue Then
				SetString(childKey, "true")
			Else
				SetString(childKey, "false")
			End If
		End Sub
		
		' Set double value (3 decimal places)
		Public Sub SetDbl(childKey As String, newValue As Double)
			Dim sign As String
			Dim absVal As Double
			Dim millis As Integer
			Dim intPart As Integer
			Dim fracPart As Integer
			Dim fracStr As String
			If newValue < 0 Then
				sign = "-"
				absVal = -newValue
			Else
				sign = ""
				absVal = newValue
			End If
			millis = CInt(absVal * 1000 + 0.5)
			intPart = CInt((millis - (millis Mod 1000)) / 1000)
			fracPart = millis Mod 1000
			fracStr = CStr(fracPart)
			While Len(fracStr) < 3
				fracStr = "0" & fracStr
			End While
			SetString(childKey, sign & CStr(intPart) & "." & fracStr)
		End Sub
		
		' Set array values
		Public Sub SetArray(childKey As String, values() As String, count As Integer)
			Dim child As AponNode
			child = GetChild(childKey)
			If child Is Nothing Then
				child = New AponNode()
				child.key = childKey
				AddChildNode(child)
			End If
			child.SetArrayData(values, count)
		End Sub
		
		' Add or get existing block child (returns the block node)
		Public Function AddBlock(childKey As String) As AponNode
			Dim existing As AponNode
			existing = GetChild(childKey)
			If existing Is Nothing Then
				Dim child As New AponNode(childKey)
				AddChildNode(child)
				Return child
			Else
				Return existing
			End If
		End Function
		
		' Remove child by key
		Public Sub RemoveChild(childKey As String)
			Dim i As Integer
			Dim j As Integer
			For i = 0 To m_childCount - 1
				If m_children(i).key = childKey Then
					For j = i To m_childCount - 2
						m_children(j) = m_children(j + 1)
					Next
					m_childCount = m_childCount - 1
					Exit Sub
				End If
			Next
		End Sub
		
		
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		''''''''''''''''''''' INTERNAL '''''''''''''''''''''''''''''
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		
		' Set this node as a value node (used by SetString and parser)
		Public Sub SetValueData(newValue As String)
			m_value = newValue
			m_nodeType = APON_VALUE
		End Sub
		
		' Set this node as a value node with type hint (parser use)
		Public Sub SetValueDataTyped(newValue As String, hint As String)
			m_value = newValue
			m_typeHint = hint
			m_nodeType = APON_VALUE
		End Sub
		
		' Set this node as a text (multi-line) node
		Public Sub SetTextData(newValue As String)
			m_value = newValue
			m_typeHint = "text"
			m_nodeType = APON_TEXT
		End Sub
		
		' Set this node as an array node (used by SetArray and parser)
		Public Sub SetArrayData(values() As String, count As Integer)
			Dim i As Integer
			If count < 0 Then
				count = 0
			End If
			m_nodeType = APON_ARRAY
			m_arrayCount = count
			If count <= 0 Then
				ReDim m_arrayValues(0)
				Exit Sub
			End If
			ReDim m_arrayValues(count - 1)
			For i = 0 To count - 1
				m_arrayValues(i) = values(i)
			Next
		End Sub
		
		' Append child node directly
		Public Sub AddChildNode(child As AponNode)
			If m_children.Length <= m_childCount Then
				ReDim Preserve m_children(m_childCount * 2)
			End If
			m_children(m_childCount) = child
			m_childCount = m_childCount + 1
		End Sub
		
	End Class
	
	
	''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
	'''''''''''''''''''''''''''' AponFile '''''''''''''''''''''''''''
	''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
	
	Public Class AponFile
		
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		'''''''''''''''''''''''' PRIVATE ''''''''''''''''''''''''''''
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		
		Private Dim m_root As AponNode
		Private Dim m_filename As String
		
		' Character-based parser state (LoadFromString/Load)
		Private Dim m_src As String
		Private Dim m_srcLen As Integer
		Private Dim m_pos As Integer
		
		
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		'''''''''''''''''''''' CONSTRUCTORS '''''''''''''''''''''''''
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		
		Public Sub New()
			m_root = New AponNode()
			m_filename = ""
		End Sub
		
		Public Sub New(filename As String)
			m_root = New AponNode()
			m_filename = ""
			Load(filename)
		End Sub
		
		
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		'''''''''''''''''''''' PROPERTIES '''''''''''''''''''''''''''
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		
		Public Property fileName As String
			Get
				Return m_filename
			End Get
			Set (value As String)
				m_filename = value
			End Set
		End Property
		
		Public ReadOnly Property root As AponNode
			Get
				Return m_root
			End Get
		End Property
		
		
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		'''''''''''''''''''' LOAD / SAVE ''''''''''''''''''''''''''''
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		
		Public Sub Load(filename As String)
			m_filename = filename
			
			Dim reader As New StreamReader(m_filename)
			If reader Is Nothing Then
				OBS.cehThrow(-508, "APON file not exist: " + m_filename)
			End If
			
			' 파일 전체를 문자열로 수집 후 문자 기반 파서에 위임
			Dim content As String
			Dim line As String
			Dim firstLine As Integer
			content = ""
			firstLine = 1
			Do While reader.Peek() >= 0
				line = reader.ReadLine()
				If firstLine = 1 Then
					content = line
					firstLine = 0
				Else
					content = content & FND.CRLF & line
				End If
			Loop
			reader.Close()
			
			LoadFromString(content)
		End Sub
		
		Public Sub Save()
			SaveToFile()
		End Sub
		
		Public Sub SaveToFile()
			Dim writer As New StreamWriter(m_filename)
			If writer Is Nothing Then
				OBS.cehThrow(-520, "APON file cannot open: " + m_filename)
			End If
			writer.Write(BuildString())
			writer.Close()
		End Sub
		
		' 문자열에서 APON 로드 (DAS/저장소 연동용, 공식 APON 스펙 서브셋 지원)
		Public Sub LoadFromString(content As String)
			If content = "" Then
				m_root = New AponNode()
				Exit Sub
			End If
			m_src = content
			m_srcLen = Len(content)
			m_pos = 0
			m_root = ParseSource()
		End Sub

		' APON 트리를 PRETTY 스타일 문자열로 직렬화
		Public Function BuildString() As String
			Return BuildStringStyled(APON_STYLE_PRETTY)
		End Function
		
		' 스타일 선택 직렬화 (PRETTY / SINGLE_LINE / COMPACT)
		Public Function BuildStringStyled(style As Integer) As String
			If style = APON_STYLE_SINGLE_LINE Then
				Return BuildSingleLine(m_root, " ", ", ")
			End If
			If style = APON_STYLE_COMPACT Then
				Return BuildSingleLine(m_root, "", ",")
			End If
			Return BuildBlockString(m_root, 0)
		End Function
		
		
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		''''''''''''''''' CHARACTER-BASED PARSER '''''''''''''''''''''
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		
		' 루트 진입: 컴팩트(바깥 {} 없음) / 비컴팩트({ ... }) / 루트 배열([ ... ]) 모두 허용
		Private Function ParseSource() As AponNode
			Dim root As New AponNode()
			SkipWhitespace()
			If m_pos < m_srcLen Then
				Dim c As String
				c = m_src.Substring(m_pos, 1)
				If c = "{" Then
					m_pos = m_pos + 1
					ParseEntries(root, "}")
					Return root
				End If
				If c = "[" Then
					' 루트 레벨 배열: root 자체를 array 노드로 사용
					m_pos = m_pos + 1
					ParseArrayBody(root)
					Return root
				End If
			End If
			ParseEntries(root, "")
			Return root
		End Function
		
		' block에 엔트리를 채운다. endChar("}" 또는 "")를 만나면 종료.
		Private Sub ParseEntries(block As AponNode, endChar As String)
			Dim c As String
			Dim theKey As String
			Dim theType As String
			While True
				SkipWhitespace()
				If m_pos >= m_srcLen Then
					Exit While
				End If
				c = m_src.Substring(m_pos, 1)
				If Len(endChar) > 0 And c = endChar Then
					m_pos = m_pos + 1
					Exit While
				End If
				' 한 엔트리: key[(type)] ':' value
				ReadKeyAndType(theKey, theType)
				SkipSpacesInline()
				If m_pos < m_srcLen And m_src.Substring(m_pos, 1) = ":" Then
					m_pos = m_pos + 1
				End If
				SkipSpacesInline()
				ParseValueInto(block, theKey, theType)
			End While
		End Sub
		
		' 'key' 또는 'key(type)' 에서 key/type 분리. 공식 스펙상 ':' 전까지.
		Private Sub ReadKeyAndType(ByRef outKey As String, ByRef outType As String)
			Dim start As Integer
			Dim c As String
			outType = ""
			start = m_pos
			While m_pos < m_srcLen
				c = m_src.Substring(m_pos, 1)
				If c = ":" Or c = "(" Or c = Chr(10) Or c = Chr(13) Then
					Exit While
				End If
				m_pos = m_pos + 1
			End While
			outKey = m_src.Substring(start, m_pos - start).Trim()
			
			If m_pos < m_srcLen And m_src.Substring(m_pos, 1) = "(" Then
				m_pos = m_pos + 1
				Dim tStart As Integer
				tStart = m_pos
				While m_pos < m_srcLen
					c = m_src.Substring(m_pos, 1)
					If c = ")" Then
						Exit While
					End If
					m_pos = m_pos + 1
				End While
				outType = m_src.Substring(tStart, m_pos - tStart).Trim()
				If m_pos < m_srcLen Then
					m_pos = m_pos + 1  ' consume ')'
				End If
			End If
		End Sub
		
		' key에 대한 값 하나를 파싱하여 parent에 자식으로 추가
		Private Sub ParseValueInto(parent As AponNode, theKey As String, theType As String)
			Dim c As String
			SkipSpacesInline()
			If m_pos >= m_srcLen Then
				Dim emptyNode As New AponNode(theKey)
				emptyNode.SetValueDataTyped("", theType)
				parent.AddChildNode(emptyNode)
				Exit Sub
			End If
			c = m_src.Substring(m_pos, 1)
			If c = Chr(10) Or c = Chr(13) Then
				Dim emptyNode2 As New AponNode(theKey)
				emptyNode2.SetValueDataTyped("", theType)
				parent.AddChildNode(emptyNode2)
				Exit Sub
			End If
			If c = "{" Then
				m_pos = m_pos + 1
				Dim blk As New AponNode(theKey)
				blk.typeHint = theType
				ParseEntries(blk, "}")
				parent.AddChildNode(blk)
				Exit Sub
			End If
			If c = "[" Then
				m_pos = m_pos + 1
				Dim an As New AponNode(theKey)
				an.typeHint = theType
				ParseArrayBody(an)
				parent.AddChildNode(an)
				Exit Sub
			End If
			If c = "(" Then
				' text 블록 (type=="text" 표준, 미지정도 관대 허용)
				m_pos = m_pos + 1
				Dim tn As New AponNode(theKey)
				Dim txt As String
				txt = ParseTextBody()
				tn.SetTextData(txt)
				If Len(theType) > 0 Then
					tn.typeHint = theType
				End If
				parent.AddChildNode(tn)
				Exit Sub
			End If
			' 단일 스칼라 값 (따옴표 또는 비따옴표), 행 끝/인라인 주석 전까지
			Dim v As String
			If c = """" Then
				v = ParseQuoted()
			Else
				v = ReadRawUntilDelim(False)
			End If
			Dim vn As New AponNode(theKey)
			vn.SetValueDataTyped(v, theType)
			parent.AddChildNode(vn)
		End Sub
		
		' 따옴표 문자열 파싱. 호출 시 m_pos는 '"' 위치.
		Private Function ParseQuoted() As String
			Dim sb As String
			Dim c As String
			Dim nc As String
			sb = ""
			m_pos = m_pos + 1  ' consume opening "
			While m_pos < m_srcLen
				c = m_src.Substring(m_pos, 1)
				m_pos = m_pos + 1
				If c = """" Then
					Return sb
				End If
				If c = "\" And m_pos < m_srcLen Then
					nc = m_src.Substring(m_pos, 1)
					m_pos = m_pos + 1
					If nc = "n" Then
						sb = sb & Chr(10)
					ElseIf nc = "r" Then
						sb = sb & Chr(13)
					ElseIf nc = "t" Then
						sb = sb & Chr(9)
					ElseIf nc = """" Then
						sb = sb & """"
					ElseIf nc = "\" Then
						sb = sb & "\"
					ElseIf nc = "'" Then
						sb = sb & "'"
					Else
						' 미지원 이스케이프는 원문 보존
						sb = sb & nc
					End If
				Else
					sb = sb & c
				End If
			End While
			Return sb
		End Function
		
		' 비따옴표 스칼라 값을 EOL/'#' 까지 읽음. inArray=True면 ','와 ']'도 구분자.
		Private Function ReadRawUntilDelim(inArray As Boolean) As String
			Dim start As Integer
			Dim c As String
			start = m_pos
			While m_pos < m_srcLen
				c = m_src.Substring(m_pos, 1)
				If c = Chr(10) Or c = Chr(13) Or c = "#" Then
					Exit While
				End If
				If inArray And (c = "," Or c = "]") Then
					Exit While
				End If
				m_pos = m_pos + 1
			End While
			Return RTrimSpaces(m_src.Substring(start, m_pos - start))
		End Function
		
		' 문자열 오른쪽 공백/탭 제거 (String.Trim()은 양쪽이지만 왼쪽은 이미 스킵된 상태)
		Private Function RTrimSpaces(s As String) As String
			Dim i As Integer
			Dim c As String
			i = Len(s)
			While i > 0
				c = Mid(s, i, 1)
				If c = " " Or c = Chr(9) Then
					i = i - 1
				Else
					Exit While
				End If
			End While
			If i <= 0 Then
				Return ""
			End If
			Return Mid(s, 1, i)
		End Function
		
		' 배열 바디 파싱. 호출 시 m_pos는 '[' 바로 다음. ']'까지 반복.
		' 요소 구분자는 ','와 줄바꿈 모두 허용.
		' 요소가 '{' 또는 '['로 시작하면 매칭 괄호까지 원시 텍스트로 수집.
		Private Sub ParseArrayBody(node As AponNode)
			Dim items() As String
			Dim count As Integer
			Dim c As String
			count = 0
			ReDim items(16)
			While True
				SkipWhitespace()
				If m_pos >= m_srcLen Then
					Exit While
				End If
				c = m_src.Substring(m_pos, 1)
				If c = "]" Then
					m_pos = m_pos + 1
					Exit While
				End If
				If c = "," Then
					m_pos = m_pos + 1
				Else
					Dim elem As String
					If c = """" Then
						elem = ParseQuoted()
					ElseIf c = "{" Or c = "[" Then
						elem = ReadBalanced(c)
					Else
						elem = ReadRawUntilDelim(True)
					End If
					If items.Length <= count Then
						ReDim Preserve items(count * 2 + 1)
					End If
					items(count) = elem
					count = count + 1
				End If
			End While
			node.SetArrayData(items, count)
		End Sub
		
		' '{' 또는 '['로 시작하는 덩어리를 매칭 괄호까지 원시 텍스트로 반환 (따옴표/주석 인식).
		Private Function ReadBalanced(openCh As String) As String
			Dim start As Integer
			Dim depth As Integer
			Dim c As String
			Dim closeCh As String
			Dim inQuote As Boolean
			start = m_pos
			depth = 0
			inQuote = False
			If openCh = "{" Then
				closeCh = "}"
			Else
				closeCh = "]"
			End If
			While m_pos < m_srcLen
				c = m_src.Substring(m_pos, 1)
				If inQuote Then
					If c = "\" And m_pos + 1 < m_srcLen Then
						m_pos = m_pos + 2
					ElseIf c = """" Then
						inQuote = False
						m_pos = m_pos + 1
					Else
						m_pos = m_pos + 1
					End If
				Else
					If c = """" Then
						inQuote = True
						m_pos = m_pos + 1
					ElseIf c = "#" Then
						While m_pos < m_srcLen
							If m_src.Substring(m_pos, 1) = Chr(10) Then
								Exit While
							End If
							m_pos = m_pos + 1
						End While
					ElseIf c = openCh Then
						depth = depth + 1
						m_pos = m_pos + 1
					ElseIf c = closeCh Then
						depth = depth - 1
						m_pos = m_pos + 1
						If depth = 0 Then
							Exit While
						End If
					Else
						m_pos = m_pos + 1
					End If
				End If
			End While
			Return m_src.Substring(start, m_pos - start).Trim()
		End Function
		
		' text 블록. 호출 시 m_pos는 '(' 바로 다음.
		' 각 라인 '|' 이후 내용을 LF로 결합해 반환. ')' 단독 라인에서 종료.
		Private Function ParseTextBody() As String
			Dim sb As String
			Dim first As Boolean
			Dim c As String
			sb = ""
			first = True
			While m_pos < m_srcLen
				SkipSpacesInline()
				If m_pos >= m_srcLen Then
					Exit While
				End If
				c = m_src.Substring(m_pos, 1)
				If c = ")" Then
					m_pos = m_pos + 1
					Exit While
				End If
				If c = Chr(10) Or c = Chr(13) Then
					m_pos = m_pos + 1
				ElseIf c = "|" Then
					m_pos = m_pos + 1
					Dim lineStart As Integer
					lineStart = m_pos
					Dim lc As String
					While m_pos < m_srcLen
						lc = m_src.Substring(m_pos, 1)
						If lc = Chr(10) Or lc = Chr(13) Then
							Exit While
						End If
						m_pos = m_pos + 1
					End While
					If Not first Then
						sb = sb & Chr(10)
					End If
					first = False
					sb = sb & m_src.Substring(lineStart, m_pos - lineStart)
				Else
					' 파이프/닫는 괄호 아닌 라인은 스킵
					While m_pos < m_srcLen
						If m_src.Substring(m_pos, 1) = Chr(10) Then
							Exit While
						End If
						m_pos = m_pos + 1
					End While
				End If
			End While
			Return sb
		End Function
		
		' 공백/탭/줄바꿈/'#'주석을 모두 스킵
		Private Sub SkipWhitespace()
			Dim c As String
			While m_pos < m_srcLen
				c = m_src.Substring(m_pos, 1)
				If c = " " Or c = Chr(9) Or c = Chr(10) Or c = Chr(13) Then
					m_pos = m_pos + 1
				ElseIf c = "#" Then
					While m_pos < m_srcLen
						c = m_src.Substring(m_pos, 1)
						m_pos = m_pos + 1
						If c = Chr(10) Then
							Exit While
						End If
					End While
				Else
					Exit While
				End If
			End While
		End Sub
		
		' 공백/탭만 스킵(인라인)
		Private Sub SkipSpacesInline()
			Dim c As String
			While m_pos < m_srcLen
				c = m_src.Substring(m_pos, 1)
				If c = " " Or c = Chr(9) Then
					m_pos = m_pos + 1
				Else
					Exit While
				End If
			End While
		End Sub
		
		
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		'''''''''''''''''''''''' WRITER '''''''''''''''''''''''''''''
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		
		' PRETTY 스타일 직렬화
		Private Function BuildBlockString(node As AponNode, indent As Integer) As String
			Dim i As Integer
			Dim j As Integer
			Dim prefix As String
			Dim s As String
			Dim child As AponNode
			prefix = ""
			For i = 0 To indent - 1
				prefix = prefix & "    "
			Next
			s = ""
			' 루트가 array 노드인 경우 (루트 레벨 배열)
			If node.nodeType = APON_ARRAY Then
				s = s & prefix & "[" & FND.CRLF
				For j = 0 To node.arrayCount - 1
					s = s & prefix & "    " & RenderArrayElement(node.GetArrayValue(j)) & FND.CRLF
				Next
				s = s & prefix & "]" & FND.CRLF
				Return s
			End If
			For i = 0 To node.childCount - 1
				child = node.GetChildByIndex(i)
				If child.nodeType = APON_VALUE Then
					s = s & prefix & RenderKeyWithType(child) & ": " & RenderValue(child.value) & FND.CRLF
				ElseIf child.nodeType = APON_TEXT Then
					s = s & prefix & RenderKeyWithType(child) & ": (" & FND.CRLF
					s = s & RenderTextLines(child.value, indent + 1)
					s = s & prefix & ")" & FND.CRLF
				ElseIf child.nodeType = APON_ARRAY Then
					s = s & prefix & RenderKeyWithType(child) & ": [" & FND.CRLF
					For j = 0 To child.arrayCount - 1
						s = s & prefix & "    " & RenderArrayElement(child.GetArrayValue(j)) & FND.CRLF
					Next
					s = s & prefix & "]" & FND.CRLF
				ElseIf child.nodeType = APON_BLOCK Then
					s = s & prefix & RenderKeyWithType(child) & ": {" & FND.CRLF
					s = s & BuildBlockString(child, indent + 1)
					s = s & prefix & "}" & FND.CRLF
				End If
			Next
			Return s
		End Function
		
		' SINGLE_LINE("sep"=" ", "delim"=", ") / COMPACT("","," ") 공용 직렬화
		Private Function BuildSingleLine(node As AponNode, sep As String, delim As String) As String
			Dim i As Integer
			Dim j As Integer
			Dim s As String
			Dim inner As String
			Dim child As AponNode
			s = ""
			If node.nodeType = APON_ARRAY Then
				s = "[" & sep
				For j = 0 To node.arrayCount - 1
					If j > 0 Then
						s = s & delim
					End If
					s = s & RenderArrayElement(node.GetArrayValue(j))
				Next
				s = s & sep & "]"
				Return s
			End If
			For i = 0 To node.childCount - 1
				child = node.GetChildByIndex(i)
				If i > 0 Then
					s = s & delim
				End If
				If child.nodeType = APON_VALUE Then
					s = s & RenderKeyWithType(child) & ":" & sep & RenderValue(child.value)
				ElseIf child.nodeType = APON_TEXT Then
					' text → escaped single-line string
					s = s & RenderKeyWithType(child) & ":" & sep & """" & EscapeQuoted(child.value) & """"
				ElseIf child.nodeType = APON_ARRAY Then
					inner = "[" & sep
					For j = 0 To child.arrayCount - 1
						If j > 0 Then
							inner = inner & delim
						End If
						inner = inner & RenderArrayElement(child.GetArrayValue(j))
					Next
					inner = inner & sep & "]"
					s = s & RenderKeyWithType(child) & ":" & sep & inner
				ElseIf child.nodeType = APON_BLOCK Then
					s = s & RenderKeyWithType(child) & ":" & sep & "{" & sep & BuildSingleLine(child, sep, delim) & sep & "}"
				End If
			Next
			Return s
		End Function
		
		' 값이 따옴표로 감싸져야 하는지 판단 (공식 APON 규칙)
		Private Function NeedsQuoting(v As String) As Boolean
			Dim n As Integer
			Dim i As Integer
			Dim c As String
			Dim first As String
			Dim last As String
			n = Len(v)
			If n = 0 Then
				Return True
			End If
			first = Mid(v, 1, 1)
			last = Mid(v, n, 1)
			If first = " " Or first = Chr(9) Or first = "{" Or first = "[" Or first = "(" Or first = "#" Or first = """" Then
				Return True
			End If
			If last = " " Or last = Chr(9) Then
				Return True
			End If
			For i = 1 To n
				c = Mid(v, i, 1)
				If c = """" Or c = "\" Or c = "#" Or c = "," Or c = Chr(10) Or c = Chr(13) Then
					Return True
				End If
			Next
			Return False
		End Function
		
		' 따옴표 안에서의 이스케이프 적용
		Private Function EscapeQuoted(v As String) As String
			Dim i As Integer
			Dim c As String
			Dim r As String
			r = ""
			For i = 1 To Len(v)
				c = Mid(v, i, 1)
				If c = "\" Then
					r = r & "\\"
				ElseIf c = """" Then
					r = r & "\" & """"
				ElseIf c = Chr(10) Then
					r = r & "\n"
				ElseIf c = Chr(13) Then
					r = r & "\r"
				ElseIf c = Chr(9) Then
					r = r & "\t"
				Else
					r = r & c
				End If
			Next
			Return r
		End Function
		
		' 스칼라 값 렌더 (필요 시 따옴표 감싸기)
		Private Function RenderValue(v As String) As String
			If NeedsQuoting(v) Then
				Return """" & EscapeQuoted(v) & """"
			End If
			Return v
		End Function
		
		' key 또는 key(type) 렌더
		Private Function RenderKeyWithType(child As AponNode) As String
			If Len(child.typeHint) > 0 Then
				Return child.key & "(" & child.typeHint & ")"
			End If
			Return child.key
		End Function
		
		' 배열 원소 렌더. 중첩 블록/배열은 원시 텍스트 그대로 출력.
		Private Function RenderArrayElement(v As String) As String
			Dim first As String
			If Len(v) = 0 Then
				Return """" & """"
			End If
			first = Mid(v, 1, 1)
			If first = "{" Or first = "[" Then
				Return v
			End If
			Return RenderValue(v)
		End Function
		
		' text 노드의 내용을 '|' 접두 라인으로 렌더
		Private Function RenderTextLines(txt As String, indent As Integer) As String
			Dim prefix As String
			Dim i As Integer
			Dim n As Integer
			Dim lineStart As Integer
			Dim c As String
			Dim line As String
			Dim result As String
			prefix = ""
			For i = 0 To indent - 1
				prefix = prefix & "    "
			Next
			result = ""
			n = Len(txt)
			lineStart = 1
			i = 1
			While i <= n
				c = Mid(txt, i, 1)
				If c = Chr(10) Then
					line = Mid(txt, lineStart, i - lineStart)
					If Len(line) > 0 And Mid(line, Len(line), 1) = Chr(13) Then
						line = Mid(line, 1, Len(line) - 1)
					End If
					result = result & prefix & "|" & line & FND.CRLF
					lineStart = i + 1
				End If
				i = i + 1
			End While
			If lineStart <= n Then
				line = Mid(txt, lineStart, n - lineStart + 1)
				If Len(line) > 0 And Mid(line, Len(line), 1) = Chr(13) Then
					line = Mid(line, 1, Len(line) - 1)
				End If
				result = result & prefix & "|" & line & FND.CRLF
			End If
			Return result
		End Function
		
	End Class
	
	
	''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
	''''''''''''''''''''''''''' AponStore '''''''''''''''''''''''''''
	''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
	
	' AponStore: AponFile 기반 저장소 래퍼
	' - AponFile(순수 파서)을 내부 보유, 트리 읽기/쓰기는 root 프로퍼티로 위임
	' - DAS 경유 비동기/동기 저장 (Flash 보호)
	' - 메타데이터 추적 (_SaveCount, _LastSaveTime)
	' - 변경 감지 (BuildDataSignature) → 불필요한 저장 방지
	
	Public Class AponStore
		
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		'''''''''''''''''''''''' PRIVATE ''''''''''''''''''''''''''''
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		
		Private Dim m_file As AponFile
		Private Dim m_path As String
		
		' 메타데이터
		Private Dim m_saveCount As Integer
		Private Dim m_lastSaveTime As String
		Private Dim m_enableMetadata As Integer
		
		' 변경 감지
		Private Dim m_lastDataSig As String
		Private Dim m_dataChanged As Integer
		
		' 디버그
		Private Dim m_debug As Integer
		
		
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		'''''''''''''''''''''' CONSTRUCTORS '''''''''''''''''''''''''
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		
		Public Sub New()
			m_file = New AponFile()
			m_path = ""
			m_enableMetadata = 1
			m_lastDataSig = ""
		End Sub
		
		Public Sub New(path As String)
			m_file = New AponFile()
			m_path = path
			m_enableMetadata = 1
			m_lastDataSig = ""
		End Sub
		
		
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		'''''''''''''''''''''' PROPERTIES '''''''''''''''''''''''''''
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		
		Public Property Path As String
			Get
				Return m_path
			End Get
			Set(value As String)
				m_path = value
			End Set
		End Property
		
		' AponNode 루트 (직접 트리 조작용)
		Public ReadOnly Property root As AponNode
			Get
				Return m_file.root
			End Get
		End Property
		
		' 내부 AponFile 직접 접근 (파일 기반 Load/Save 등)
		Public ReadOnly Property file As AponFile
			Get
				Return m_file
			End Get
		End Property
		
		
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		'''''''''''''''''''''' METADATA '''''''''''''''''''''''''''''
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		
		Public Sub EnableMetadata(enable As Integer)
			If enable <> 0 Then
				m_enableMetadata = 1
			Else
				m_enableMetadata = 0
			End If
		End Sub
		
		Public Sub SetDebug(level As Integer)
			If level <= 0 Then
				m_debug = 0
			Else
				m_debug = level
			End If
		End Sub
		
		Public Function GetSaveCount() As Integer
			Return m_saveCount
		End Function
		
		Public Function GetLastSaveTime() As String
			Return m_lastSaveTime
		End Function
		
		Public Sub ResetMetadata()
			m_saveCount = 0
			m_lastSaveTime = ""
		End Sub
		
		
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		'''''''''''''''''' CHANGE DETECTION '''''''''''''''''''''''''
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		
		' 재귀적으로 트리 시그니처 생성 (데이터 변경 감지용)
		Private Function BuildNodeSignature(node As AponNode) As String
			Dim sig As String
			Dim i As Integer
			Dim j As Integer
			Dim child As AponNode
			
			sig = ""
			For i = 0 To node.childCount - 1
				child = node.GetChildByIndex(i)
				sig = sig & CStr(Len(child.key)) & ":" & child.key & "="
				
				If child.nodeType = APON_VALUE Then
					sig = sig & "V" & CStr(Len(child.value)) & ":" & child.value
				ElseIf child.nodeType = APON_ARRAY Then
					sig = sig & "A" & CStr(child.arrayCount)
					For j = 0 To child.arrayCount - 1
						sig = sig & "," & CStr(Len(child.GetArrayValue(j))) & ":" & child.GetArrayValue(j)
					Next
				ElseIf child.nodeType = APON_BLOCK Then
					sig = sig & "B{" & BuildNodeSignature(child) & "}"
				End If
				sig = sig & "|"
			Next
			Return sig
		End Function
		
		Private Function BuildDataSignature() As String
			Return BuildNodeSignature(m_file.root)
		End Function
		
		
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		'''''''''''''''''''' FILE I/O '''''''''''''''''''''''''''''''
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		
		' 저장 공통 준비 (DAT 패턴 호환)
		' return: 1=저장 진행, 0=스킵 (변경 없음)
		Private Function PrepareSaveCommon(opName As String, ByRef curSig As String, ByRef content As String) As Integer
			curSig = BuildDataSignature()
			
			DebugLogVerbose("[DEBUG] " & opName & " signature | CurSigLen=" & CStr(Len(curSig)) & " | LastSigLen=" & CStr(Len(m_lastDataSig)))
			
			If curSig = m_lastDataSig Then
				DebugLog("[DEBUG] " & opName & " skipped (no data change) | Path=" & m_path)
				m_dataChanged = 0
				Return 0
			End If
			DebugLog("[DEBUG] " & opName & " will save | Path=" & m_path)
			
			If m_enableMetadata = 1 Then
				m_saveCount = m_saveCount + 1
				m_lastSaveTime = FND.timeString()
			End If
			
			content = BuildSaveContent()
			Return 1
		End Function
		
		' 메타데이터 + APON 데이터 결합
		Private Function BuildSaveContent() As String
			Dim s As String
			s = ""
			
			If m_enableMetadata = 1 Then
				s = s & "# === Metadata ===" & FND.CRLF
				s = s & "# _SaveCount: " & CStr(m_saveCount) & FND.CRLF
				s = s & "# _LastSaveTime: " & m_lastSaveTime & FND.CRLF
				s = s & FND.CRLF
			End If
			
			s = s & m_file.BuildString()
			Return s
		End Function
		
		' DAS 경유 비동기 저장
		Public Sub SaveAsync()
			If m_path = "" Then
				OBS.cehLog("ERR: AponStore.SaveAsync - Path not set", "AponStore")
				Exit Sub
			End If
			
			Dim curSig As String
			Dim content As String
			If PrepareSaveCommon("SaveAsync", curSig, content) = 0 Then
				Exit Sub
			End If
			
			PIP.Enqueue(m_path, content)
			DebugLog("[DEBUG] SaveAsync enqueued | Path=" & m_path & " | SaveCount=" & CStr(m_saveCount))
			
			m_lastDataSig = curSig
			m_dataChanged = 0
		End Sub
		
		' DAS 경유 동기 저장
		Public Function SaveSync() As Integer
			If m_path = "" Then
				OBS.cehLog("ERR: AponStore.SaveSync - Path not set", "AponStore")
				Return -1
			End If
			
			Dim curSig As String
			Dim content As String
			If PrepareSaveCommon("SaveSync", curSig, content) = 0 Then
				Return 1
			End If
			
			Dim result As Integer
			result = PIP.SaveSync(m_path, content)
			DebugLog("[DEBUG] SaveSync done | Result=" & CStr(result) & " | Path=" & m_path & " | SaveCount=" & CStr(m_saveCount))
			
			If result = 1 Then
				m_lastDataSig = curSig
				m_dataChanged = 0
			End If
			Return result
		End Function
		
		' DAS 경유 로드 (동기)
		Public Function LoadFromFile() As Integer
			If m_path = "" Then
				OBS.cehLog("ERR: AponStore.LoadFromFile - Path not set", "AponStore")
				Return 0
			End If
			DebugLog("[DEBUG] LoadFromFile start | Path=" & m_path)
			
			If PIP.FileExists(m_path) = 0 Then
				OBS.cehLog("WARN: AponStore.LoadFromFile - File not exist | Path: " & m_path, "AponStore")
				Return 0
			End If
			
			Dim content As String
			Dim ex As New Exception
			
			Try
				content = PIP.ReadFile(m_path)
				If content = "" Then
					Return 0
				End If
				
				ExtractMetadata(content)
				m_file.LoadFromString(content)
				
				m_lastDataSig = BuildDataSignature()
				m_dataChanged = 0
				DebugLog("[DEBUG] LoadFromFile done | Path=" & m_path & " | SaveCount=" & CStr(m_saveCount) & " | SigLen=" & CStr(Len(m_lastDataSig)))
				Return 1
			Catch ex
				OBS.cehLogEx(ex, "AponStore.LoadFromFile | Path: " & m_path)
				Return 0
			End Try
		End Function
		
		' 백업 복구
		Public Function RestoreFromBackup() As Integer
			If m_path = "" Then
				Return 0
			End If
			
			RestoreFromBackup = PIP.RestoreFromBackup(m_path)
			If RestoreFromBackup = 1 Then
				LoadFromFile()
			End If
		End Function
		
		
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		'''''''''''''''''' METADATA EXTRACTION ''''''''''''''''''''''
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		
		Private Sub ExtractMetadata(content As String)
			Dim saveCountStr As String
			Dim timeStr As String
			
			saveCountStr = ExtractMetadataValue(content, "# _SaveCount: ")
			If Len(saveCountStr) > 0 Then
				m_saveCount = CInt(saveCountStr)
			End If
			
			timeStr = ExtractMetadataValue(content, "# _LastSaveTime: ")
			If Len(timeStr) > 0 Then
				m_lastSaveTime = timeStr
			End If
			
			DebugLogVerbose("[DEBUG] Metadata extracted | SaveCount=" & CStr(m_saveCount) & " | LastSaveTime=" & m_lastSaveTime)
		End Sub
		
		Private Function ExtractMetadataValue(content As String, metaKey As String) As String
			Dim position As Integer
			Dim lineEnd As Integer
			Dim valueStr As String
			
			position = InStr(1, content, metaKey)
			If position > 0 Then
				position = position + Len(metaKey)
				lineEnd = InStr(position, content, FND.CRLF)
				If lineEnd = 0 Then
					lineEnd = Len(content) + 1
				End If
				valueStr = Mid(content, position, lineEnd - position)
				Return valueStr.Trim()
			End If
			Return ""
		End Function
		
		
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		'''''''''''''''''''''' DEBUG HELPERS ''''''''''''''''''''''''
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		
		Private Sub DebugLog(msg As String)
			If m_debug <> 0 Then
				OBS.cehLog(msg, "AponStore")
			End If
		End Sub
		
		Private Sub DebugLogVerbose(msg As String)
			If m_debug >= 2 Then
				OBS.cehLog(msg, "AponStore")
			End If
		End Sub
		
	End Class
	

End Module


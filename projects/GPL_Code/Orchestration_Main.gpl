'Created: 9/10/2024 12:17:50 PM
'Reworked: 2026/05/08 (전체 모듈 종합 기능 테스트 + RC1403 heartbeat 임시 테스트)
'Updated: 2026/06/01 (운영 MAIN과 진단용 heartbeat loop 분리)
'Updated: 2026/06/01 (APN 모듈 사용 데모 RunAponDemo 추가)
'Updated: 2026/06/01 (RunAponDemo에서 ROMDISK/tmp 파일 저장 검증 추가)
'Updated: 2026/06/01 (AponNode.Block 체인 호출 예제로 정리)
'Updated: 2026/06/01 (APON 단일행/압축 로그를 요약형으로 정리)
'Updated: 2026/06/02 (TCP 멀티포트 4000~4003 + 포트별 command pump thread 추가)
'Updated: 2026/06/02 (TCP 서버 호출 형식을 포트 단건 호출로 단순화)
'Updated: 2026/06/02 (TCP 멀티포트/펌프/레지스트리 책임을 NET 파사드로 이전, ORCH는 초기화+시작만)
'Updated: 2026/06/02 (TCP 서버를 포트별 NET.TcpServer 객체 생성 방식으로 변경)
'Updated: 2026/06/02 (비동기 명령 경로 데모 ASYNC 등록 + 연결별 회신 핸들러 추가)
'Updated: 2026/06/23 (SetCommandHandler에 명시적 New TcpCommandHandlerSub(AddressOf ...) 적용 → -205 컴파일 오류 해결)
Module ORCH_Main ' ORCH_Main VER 1.1.22

	' ============================================================
	' MAIN: 운영 기본 초기화
	' ============================================================
	Public Sub MAIN
		Dim ex As Exception
		Try
			LOG.cehLog("Runtime initialized", "MAIN")
			InitializeRuntime()

			' TCP 명령 서버: 포트별 객체 생성 시 listen + command pump 자동 시작.
			' (멀티포트/펌프/세션 관리 상세는 NET.TcpServer 내부가 담당)
			Dim S4000 As New TcpServer(4000)
			Dim S4001 As New TcpServer(4001)
			Dim S4002 As New TcpServer(4002)
			Dim S4003 As New TcpServer(4003)

			' === 비동기 명령 경로 데모 (검증용, 운영 명령 도입 시 교체/제거) ===
			' 클라이언트가 "ASYNC <text>"를 보내면 즉시 "OK QUEUED ASYNC" ACK를 받고,
			' command pump 스레드가 OnTcpAsyncDemo를 호출해 발신 연결로만 결과를 회신한다.
			' 같은 포트의 다른 클라이언트에는 결과가 가지 않는다(연결별 라우팅 검증).
			NPR.RegisterAsyncCommand("ASYNC")
			S4000.SetCommandHandler(New TcpCommandHandlerSub(AddressOf OnTcpAsyncDemo))
			S4001.SetCommandHandler(New TcpCommandHandlerSub(AddressOf OnTcpAsyncDemo))
			S4002.SetCommandHandler(New TcpCommandHandlerSub(AddressOf OnTcpAsyncDemo))
			S4003.SetCommandHandler(New TcpCommandHandlerSub(AddressOf OnTcpAsyncDemo))

		Catch ex
			LOG.cehLogEx(ex, "ORCH_Main.MAIN")
		End Try
	End Sub

	' 운영/테스트 공통 런타임 초기화.
	Public Sub InitializeRuntime()
		DBG.SetEnabled(0) ' 기본 운영 경로에서는 텔레메트리 오버헤드 제거
		DBG.SetVerbose(0)
		LOG.SetIncludeThreadName(1) ' 멀티스레드 로그에 스레드 이름 포함
		PST.CleanupTempFiles()
	End Sub

	' 비동기 명령 데모 핸들러 (검증용): command pump 스레드에서 호출된다.
	' connId(발신 연결)로만 결과를 회신해 연결별 라우팅이 동작함을 확인한다.
	' 운영 도메인 명령이 생기면 이 핸들러를 실제 처리로 교체한다.
	Public Sub OnTcpAsyncDemo(ByVal serverIndex As Integer, ByVal connId As Integer, ByVal port As String, ByVal line As String)
		LOG.cehLog("ASYNC handling | conn=" & CStr(connId) & " | port=" & port & " | " & line, "ORCH_Main.OnTcpAsyncDemo")
		TcpServer.ReplyLineToConn(connId, "ASYNC DONE conn=" & CStr(connId) & " :" & line)
	End Sub
End Module


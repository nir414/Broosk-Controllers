'Created: 2026/06/15
'Purpose: 범용 TCP 클라이언트 전송 계층 (outbound 연결 + 라인 단위 동기 송수신)
' - TcpClientConn: 외부 장비/서버 1곳과의 TCP 연결을 캡슐화한 객체.
' - CRLF 라인 프레이밍 + 락 보호 동기 송수신 + 동기 요청/응답(Request)을 제공한다.
' - Module NET(Networking_TcpServer)이 inbound(서버)를 담당하는 것과 대칭으로,
'   본 모듈은 outbound(클라이언트)를 담당한다.
' - 특정 장비 프로토콜에 의존하지 않는다(line in/out만). 명령/상태 해석은 상위 계층 몫.
'
'Requires:
' - Concurrency_SpinLock.gpl   (Module SNC): SpinLock (송수신/요청 임계영역 보호)
' - Observability_Logger.gpl   (Module LOG): cehLog/cehLogEx/cehLogExThrottled
' - Foundation_Utils.gpl       (Module FND): CRLF 상수, Controller.Timer 기반 시각
' - Parsing_StringUtils.gpl    (Module PRS): SafeTrim
'Used by:
' - 라인 기반 외부 장비/서버에 접속하는 모든 상위 모듈
'   (예: KDY_Module의 InthTransport가 본 클래스를 래핑)
'
' 반환 코드 규약 (Module NET과 동일):
'   ReceiveLine/Request: 1=라인 수신, 0=타임아웃(완성 라인 없음), -1=연결 종료/소켓 에러
'   Connect/Reconnect/SendRaw/SendLine: 1=성공, 0=실패
'
' 동시성 모델:
'   - m_ioLock : 개별 소켓 I/O(Send/Receive) 원자성 보호.
'   - m_reqLock: Request(flush->send->receive) 다단계 시퀀스를 한 호출 단위로 직렬화.
'                (SpinLock은 재진입 불가이므로 I/O락과 분리한다.)
Module NTC ' Networking_TcpClient VER 1.0.0

	' 수신 슬라이스 1회 최대 대기(ms). 전체 timeout은 ReceiveLine 인자로 제어.
	Private Const RX_SLICE_MS As Integer = 200
	' Flush 드레인 슬라이스(ms). 호출 간 잔류 제거용이라 짧게 잡아 idle 오버헤드를 줄인다.
	Private Const FLUSH_SLICE_MS As Integer = 20

	Public Class TcpClientConn

		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		'''''''''''''''''''''''' PRIVATE ''''''''''''''''''''''''''''
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''

		Private Dim m_id As Integer
		Private Dim m_ip As String
		Private Dim m_port As Integer
		Private Dim m_client As TcpClient
		Private Dim m_endPoint As IPEndPoint
		Private Dim m_connected As Integer
		' 수신 누적 버퍼 (CRLF 단위로 잘라 라인 단위 반환)
		Private Dim m_rxBuf As String
		' 개별 소켓 I/O 보호
		Private Dim m_ioLock As New SpinLock
		' 요청/응답 다단계 직렬화 (I/O락과 분리: SpinLock 재진입 방지)
		Private Dim m_reqLock As New SpinLock


		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		'''''''''''''''''''''' CONSTRUCTOR ''''''''''''''''''''''''''
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''

		Public Sub New(ByVal id As Integer, ByVal ip As String, ByVal port As Integer)
			m_id = id
			m_ip = PRS.SafeTrim(ip)
			m_port = port
			m_connected = 0
			m_rxBuf = ""
		End Sub


		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		'''''''''''''''''''''' PROPERTIES '''''''''''''''''''''''''''
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''

		Public ReadOnly Property Id As Integer
			Get
				Return m_id
			End Get
		End Property

		Public ReadOnly Property Ip As String
			Get
				Return m_ip
			End Get
		End Property

		Public ReadOnly Property Port As Integer
			Get
				Return m_port
			End Get
		End Property


		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		'''''''''''''''''''''' CONNECT ''''''''''''''''''''''''''''''
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''

		' TCP 연결. 1=성공, 0=실패.
		Public Function Connect() As Integer
			Dim ex As Exception
			m_ioLock.Acquire()
			Try
				m_client = New TcpClient()
				m_endPoint = New IPEndPoint(m_ip, m_port)
				m_client.Client.KeepAlive = True
				m_client.Client.Connect(m_endPoint)
				m_connected = 1
				m_rxBuf = ""
				LOG.cehLog("Connected | " & m_ip & ":" & CStr(m_port) & " | id=" & CStr(m_id), "NTC.Connect")
				Connect = 1
			Catch ex
				m_connected = 0
				LOG.cehLogEx(ex, "NTC.Connect - " & m_ip & ":" & CStr(m_port))
				Connect = 0
			Finally
				m_ioLock.Release()
			End Try
		End Function

		' 재연결: 기존 소켓 정리 후 동일 endPoint로 재접속. 1=성공, 0=실패.
		Public Function Reconnect() As Integer
			Dim ex As Exception
			m_ioLock.Acquire()
			Try
				m_connected = 0
				Try
					If Not m_client Is Nothing Then
						m_client.Client.Close
					End If
				Catch ex
					' 종료 과정의 예외는 무시
				End Try
				Thread.Sleep(1000)
				m_client = New TcpClient()
				If m_endPoint Is Nothing Then
					m_endPoint = New IPEndPoint(m_ip, m_port)
				End If
				m_client.Client.KeepAlive = True
				m_client.Client.Connect(m_endPoint)
				m_connected = 1
				m_rxBuf = ""
				LOG.cehLog("Reconnected | " & m_ip & ":" & CStr(m_port), "NTC.Reconnect")
				Reconnect = 1
			Catch ex
				m_connected = 0
				LOG.cehLogEx(ex, "NTC.Reconnect - " & m_ip & ":" & CStr(m_port))
				Reconnect = 0
			Finally
				m_ioLock.Release()
			End Try
		End Function

		Public Function IsConnected() As Integer
			Return m_connected
		End Function


		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		'''''''''''''''''''''''' SEND '''''''''''''''''''''''''''''''
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''

		' 원문 송신 (개행 부가 없음). 1=성공, 0=실패.
		Public Function SendRaw(ByVal text As String) As Integer
			Dim ex As Exception
			If text Is Nothing Then Return 0
			If text = "" Then Return 0
			If m_connected = 0 Then Return 0

			m_ioLock.Acquire()
			Try
				m_client.Client.Send(text)
				SendRaw = 1
			Catch ex
				m_connected = 0
				LOG.cehLogExThrottled(ex, "NTC.SendRaw | id=" & CStr(m_id), "NTC.Send", 1000)
				SendRaw = 0
			Finally
				m_ioLock.Release()
			End Try
		End Function

		' 라인 송신 (CRLF 자동 부가). 1=성공, 0=실패.
		Public Function SendLine(ByVal line As String) As Integer
			If line Is Nothing Then line = ""
			Return SendRaw(line & FND.CRLF)
		End Function


		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		'''''''''''''''''''''' RECEIVE ''''''''''''''''''''''''''''''
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''

		' CRLF로 구분된 라인 1개를 timeoutMs 안에 수신한다.
		' Return: 1=라인 수신(ByRef line), 0=타임아웃, -1=연결 종료/소켓 에러
		Public Function ReceiveLine(ByVal timeoutMs As Double, ByRef line As String) As Integer
			Dim deadline As Double
			Dim pos As Integer
			Dim sliceRet As Integer

			line = ""
			If m_connected = 0 Then Return -1

			deadline = NowMs() + timeoutMs

			While True
				' 1) 버퍼에 완성된 라인이 있으면 즉시 반환
				pos = m_rxBuf.IndexOf(FND.CRLF)
				If pos >= 0 Then
					line = m_rxBuf.Substring(0, pos)
					m_rxBuf = m_rxBuf.Substring(pos + Len(FND.CRLF))
					Return 1
				End If

				' 2) 전체 timeout 초과 검사
				If NowMs() > deadline Then
					Return 0
				End If

				' 3) 소켓에서 추가 수신 (슬라이스 단위)
				sliceRet = ReadSlice(RX_SLICE_MS)
				If sliceRet < 0 Then
					Return -1
				End If
				' sliceRet = 0 (이번 슬라이스 데이터 없음) -> 루프 계속 (deadline까지)
			End While
		End Function


		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		'''''''''''''''''''''' REQUEST/RESPONSE '''''''''''''''''''''
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''

		' 동기 요청/응답: Flush -> SendLine -> ReceiveLine 한 호출로 직렬화한다.
		' Return: 1=응답 수신(ByRef reply), 0=타임아웃, -1=연결 종료/송신 실패
		Public Function Request(ByVal line As String, ByVal timeoutMs As Double, ByRef reply As String) As Integer
			reply = ""
			If m_connected = 0 Then Return -1

			m_reqLock.Acquire()
			Try
				Flush()
				If SendLine(line) = 0 Then
					Request = -1
					Exit Try
				End If
				Request = ReceiveLine(timeoutMs, reply)
			Finally
				m_reqLock.Release()
			End Try
		End Function


		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		'''''''''''''''''''''' FLUSH / CLOSE ''''''''''''''''''''''''
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''

		' 수신 버퍼 + 소켓에 남은 미처리 데이터를 비운다 (요청 전 잔류 응답 제거).
		Public Sub Flush()
			m_rxBuf = ""
			' 소켓에 남은 즉시 가용 데이터를 짧게 드레인 (짧은 슬라이스로 idle 오버헤드 최소화)
			While ReadSlice(FLUSH_SLICE_MS) = 1
				m_rxBuf = ""
			End While
		End Sub

		' 소켓 종료. NOTE: TcpClient 참조에 Nothing 대입은 피한다(소켓 Nothing 대입 크래시 이력).
		Public Sub CloseSocket()
			Dim ex As Exception
			m_connected = 0
			If m_client Is Nothing Then Exit Sub
			Try
				m_client.Client.Close
			Catch ex
				LOG.cehLogEx(ex, "NTC.CloseSocket")
			End Try
		End Sub


		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		'''''''''''''''''''''' INTERNAL '''''''''''''''''''''''''''''
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''

		' 소켓에서 1회 수신해 버퍼에 누적한다 (sliceMs 만큼 대기).
		' Return: 1=데이터 누적, 0=데이터 없음(슬라이스 타임아웃), -1=연결 종료/에러
		Private Function ReadSlice(ByVal sliceMs As Integer) As Integer
			Dim ex As Exception
			Dim buf As String
			Dim ret As Integer

			buf = ""
			m_ioLock.Acquire()
			Try
				If m_client Is Nothing Then
					m_connected = 0
					ReadSlice = -1
					Exit Try
				End If
				ret = m_client.Client.Receive(buf, sliceMs)
				If ret < 0 Then
					m_connected = 0
					ReadSlice = -1
				ElseIf ret = 0 Then
					ReadSlice = 0
				Else
					m_rxBuf = m_rxBuf & buf
					ReadSlice = 1
				End If
			Catch ex
				m_connected = 0
				LOG.cehLogExThrottled(ex, "NTC.ReadSlice | id=" & CStr(m_id), "NTC.Recv", 1000)
				ReadSlice = -1
			Finally
				m_ioLock.Release()
			End Try
		End Function

		' 현재 시각(ms). Logger와 동일하게 Controller.Timer(1) 기반.
		Private Function NowMs() As Double
			Return Controller.Timer(1) * 1000
		End Function

	End Class

End Module
